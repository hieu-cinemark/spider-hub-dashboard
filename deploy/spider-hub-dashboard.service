[Unit]
Description=spider-hub-dashboard (next start on 127.0.0.1:3001, reached only through nginx)
After=network-online.target cinemark-api-web.service
Wants=network-online.target

[Service]
User=app
Group=app
WorkingDirectory=/opt/spider-hub-dashboard
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3001 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
