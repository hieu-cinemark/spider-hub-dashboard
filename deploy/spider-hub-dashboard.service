[Unit]
Description=spider-hub-dashboard (next start on 127.0.0.1:3001, reached only through nginx :8443 TLS + Basic Auth)
After=network-online.target cinemark-api-web.service
Wants=network-online.target

[Service]
User=app
Group=app
WorkingDirectory=/opt/spider-hub-dashboard
Environment=NODE_ENV=production
# "Đăng nhập tay" (src/app/api/manual-login/route.ts): run spider-hub's scripts/manual_login.py on the virtual display
# :99 (spider-hub deploy/login-display), with spider-hub's own .env Redis (do NOT set MANUAL_LOGIN_REDIS_PORT here);
# remote requests must have passed nginx Basic Auth.
Environment=SPIDER_HUB_DIR=/opt/spider-hub
Environment=MANUAL_LOGIN_DISPLAY=:99
Environment=MANUAL_LOGIN_ALLOW_REMOTE=1
ExecStart=/usr/bin/npm run start -- -p 3001 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
